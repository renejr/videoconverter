		{
			"name": "🔐 Autenticação",
			"item": [
				{
					"name": "Registrar Usuário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('user_id', response.id);",
									"    pm.test('Usuário criado com sucesso', () => {",
									"        pm.expect(response.email).to.not.be.empty;",
									"        pm.expect(response.id).to.not.be.empty;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"usuario@exemplo.com\",\n  \"password\": \"MinhaSenh@123\",\n  \"first_name\": \"João\",\n  \"last_name\": \"Silva\",\n  \"phone\": \"+5511999999999\",\n  \"date_of_birth\": \"1990-01-15\",\n  \"country_code\": \"BR\",\n  \"language_preference\": \"pt-BR\",\n  \"timezone\": \"America/Sao_Paulo\"\n}"
						},
