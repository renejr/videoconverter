	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script executado antes de cada requisição",
					"// Adiciona automaticamente o token de autorização se disponível",
					"const token = pm.collectionVariables.get('access_token');",
					"if (token && !pm.request.headers.has('Authorization')) {",
					"    pm.request.headers.add({",
					"        key: 'Authorization',",
					"        value: `Bearer ${token}`",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Script executado após cada requisição",
					"// Verifica se o token expirou e sugere renovação",
					"if (pm.response.code === 401) {",
					"    const response = pm.response.json();",
					"    if (response.detail && response.detail.includes('token')) {",
					"        console.log('⚠️ Token expirado. Execute o endpoint \"Renovar Token\" para obter um novo token.');",
					"    }",
					"}",
					"",
					"// Log de informações úteis",
					"console.log(`📊 Status: ${pm.response.code} | Tempo: ${pm.response.responseTime}ms`);",
					"",
					"// Testes globais de validação",
					"pm.test('Status code é válido', () => {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404, 422, 500]);",
					"});",
					"",
					"if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
					"    pm.test('Response é JSON válido', () => {",
					"        pm.expect(() => pm.response.json()).to.not.throw();",
					"    });",
					"}"
				]
			}
		}
	],
