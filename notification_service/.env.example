# Configurações do Banco de Dados MySQL
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/notifications
DB_HOST=localhost
DB_PORT=3306
DB_NAME=notifications
DB_USER=username
DB_PASSWORD=password

# Configurações da Aplicação
APP_NAME=VOD Notification Service
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8001

# Configurações de Segurança
SECRET_KEY=notification-secret-key-change-in-production

# Configurações de Email - Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=30

# Configurações de Email - Remetente
FROM_EMAIL=your-email@gmail.com
FROM_NAME=VidConv Platform
REPLY_TO=support@vidconv.com

# Configurações de SMS (Twilio)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-account-sid
SMS_AUTH_TOKEN=your-twilio-auth-token
SMS_FROM_NUMBER=+1234567890

# Configurações do Event Bus - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Configurações de Filas
QUEUE_DEFAULT=notifications
QUEUE_EMAIL=email_notifications
QUEUE_SMS=sms_notifications
QUEUE_PUSH=push_notifications

# Configurações de Rate Limiting
RATE_LIMIT_EMAIL_PER_MINUTE=10
RATE_LIMIT_SMS_PER_MINUTE=5

# Configurações de Retry
MAX_RETRIES=3
RETRY_DELAY=60

# Configurações de Templates
TEMPLATE_DIR=templates

# Configurações de Logs
LOG_LEVEL=INFO
LOG_FILE=notification_service.log

# Configurações de Monitoramento
ENABLE_METRICS=True
METRICS_PORT=9001

# Configurações de CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]